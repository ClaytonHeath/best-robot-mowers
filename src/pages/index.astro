---
import { getCollection } from "astro:content";
import ListingCard from "../components/ListingCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { COVERAGE_BANDS, NAV_LABELS, SITE_DESCRIPTION, SITE_NAME } from "../lib/site";

const listings = (await getCollection("listings", ({ data }) => data.status === "published")).sort(
  (a, b) => a.data.brand.localeCompare(b.data.brand) || a.data.model.localeCompare(b.data.model),
);

const navTypes = ["lidar", "rtk", "vision", "boundary-wire"] as const;
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION}>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">{listings.length} published listings</p>
      <h1>Robot lawn mowers, compared on facts</h1>
      <p class="lede">
        Filter by wire-free vs wire, coverage, and how the mower actually navigates.
        Each card is a real model with specs taken from the official product page — not a ranking for sale.
      </p>
    </header>

    <div class="filters" role="search" aria-label="Filter mowers">
      <fieldset>
        <legend>Boundary</legend>
        <div class="chip-row">
          <button class="chip" type="button" data-filter="wire" data-value="all" aria-pressed="true">All</button>
          <button class="chip" type="button" data-filter="wire" data-value="free" aria-pressed="false">Wire-free</button>
          <button class="chip" type="button" data-filter="wire" data-value="wire" aria-pressed="false">Boundary wire</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>Coverage</legend>
        <div class="chip-row">
          <button class="chip" type="button" data-filter="coverage" data-value="all" aria-pressed="true">All</button>
          {
            COVERAGE_BANDS.map((band) => (
              <button class="chip" type="button" data-filter="coverage" data-value={band.id} aria-pressed="false">
                {band.label}
              </button>
            ))
          }
        </div>
      </fieldset>
      <fieldset>
        <legend>Navigation</legend>
        <div class="chip-row">
          <button class="chip" type="button" data-filter="nav" data-value="all" aria-pressed="true">All</button>
          {
            navTypes.map((type) => (
              <button class="chip" type="button" data-filter="nav" data-value={type} aria-pressed="false">
                {NAV_LABELS[type]}
              </button>
            ))
          }
        </div>
      </fieldset>
    </div>

    <div class="toolbar">
      <p><span data-result-count>{listings.length} mowers</span> · tick 2–3 cards to compare</p>
      <button class="reset" type="button" data-reset hidden>Clear filters</button>
    </div>

    <section class="compare-panel" data-compare-panel hidden>
      <h2>Compare</h2>
      <table class="spec-table">
        <tbody data-compare-body></tbody>
      </table>
    </section>

    <section class="listing-grid" aria-label="Mower listings">
      {listings.map((listing) => <ListingCard listing={listing} />)}
      <p class="empty" data-empty hidden>No published mowers match those filters.</p>
    </section>
  </div>
  <script>
    import "../scripts/filters.ts";
  </script>
</BaseLayout>
