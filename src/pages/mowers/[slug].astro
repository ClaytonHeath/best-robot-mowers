---
import { getCollection, render } from "astro:content";
import ProductPhoto from "../../components/ProductPhoto.astro";
import SpecTable from "../../components/SpecTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatAcres,
  formatPrice,
  formatUpdated,
  isPresentUrl,
  listingBreadcrumbJsonLd,
  listingPhotoSrc,
  productJsonLd,
  withBase,
} from "../../lib/site";

export async function getStaticPaths() {
  const listings = await getCollection("listings", ({ data }) => data.status === "published");
  return listings.map((listing) => ({
    params: { slug: listing.data.slug },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const { Content } = await render(listing);
const d = listing.data;
const description = `${d.verdict} ${d.whoItsFor}`;
const photo = listingPhotoSrc(d.slug, d.image);
---

<BaseLayout
  title={d.title}
  description={description}
  canonicalPath={`mowers/${d.slug}`}
  type="article"
  ogImage={photo}
  jsonLd={[productJsonLd(d), listingBreadcrumbJsonLd(d)]}
>
  <div class="wrap">
    <header class="listing-hero">
      <ProductPhoto src={photo} alt={d.title} eager>
        <span class="price-stamp">{formatPrice(d.priceUsd)}</span>
      </ProductPhoto>
      <div class="listing-intro">
        <p class="kicker">
          {d.brand} · {formatAcres(d.coverageAcres)} · {d.wireFree ? "Wire-free" : "Boundary wire"}
        </p>
        <h1>{d.title}</h1>
        <p class="lede">{d.verdict}</p>
      </div>
    </header>

    <div class="listing-layout">
      <article class="prose">
        <Content />
      </article>
      <aside class="side">
        <SpecTable listing={listing} />
        <div class="cta">
          {
            isPresentUrl(d.affiliateUrl) && (
              <a class="btn btn-primary" href={d.affiliateUrl} rel="sponsored nofollow noopener">
                Check price
              </a>
            )
          }
          <a class="btn btn-ghost" href={d.officialUrl} rel="noopener noreferrer">Official product page</a>
          <p class="note">Updated {formatUpdated(d.updated)}. Specs that were not on the official page are omitted.</p>
          <p class="note"><a href={withBase()}>← All mowers</a></p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
