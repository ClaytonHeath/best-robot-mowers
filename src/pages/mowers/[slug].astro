---
import { getCollection, render } from "astro:content";
import ProductPhoto from "../../components/ProductPhoto.astro";
import RelatedListings from "../../components/RelatedListings.astro";
import SpecTable from "../../components/SpecTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { m5LidarComparison } from "../../lib/listingCompare";
import { assertLargerYardPeers, faqsForListing } from "../../lib/listingFaq";
import { pickRelatedListings } from "../../lib/related";
import {
  faqPageJsonLd,
  formatAcres,
  formatPrice,
  formatUpdated,
  isPresentUrl,
  listingBreadcrumbJsonLd,
  listingMetaDescription,
  listingPhotoSrc,
  productJsonLd,
  withBase,
} from "../../lib/site";

export async function getStaticPaths() {
  const listings = await getCollection("listings", ({ data }) => data.status === "published");
  return listings.map((listing) => ({
    params: { slug: listing.data.slug },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const { Content } = await render(listing);
const d = listing.data;
const description = listingMetaDescription(d);
const photo = listingPhotoSrc(d.slug, d.image);
const published = await getCollection("listings", ({ data }) => data.status === "published");
const related = pickRelatedListings(
  d,
  published.map((item) => item.data),
);
const faqs = faqsForListing(listing);
const comparison = d.slug === "anthbot-m5-lidar" ? m5LidarComparison(published) : null;
if (d.slug === "yarbo-lawn-mower-pro") assertLargerYardPeers(published);
const jsonLd = [productJsonLd(d), listingBreadcrumbJsonLd(d)];
if (faqs.length > 0) jsonLd.push(faqPageJsonLd(faqs));
---

<BaseLayout
  title={d.title}
  description={description}
  canonicalPath={`mowers/${d.slug}`}
  type="article"
  ogImage={photo}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <header class="listing-hero">
      <ProductPhoto src={photo} alt={d.title} eager>
        <span class="price-stamp">{formatPrice(d.priceUsd)}</span>
      </ProductPhoto>
      <div class="listing-intro">
        <p class="kicker">
          {d.brand} · {formatAcres(d.coverageAcres)} · {d.wireFree ? "Wire-free" : "Boundary wire"}
        </p>
        <h1>{d.title}</h1>
        <p class="lede">{d.verdict}</p>
      </div>
    </header>

    <div class="listing-layout">
      <article class="prose">
        <Content />
        {
          comparison && (
            <section id="comparison" aria-labelledby="comparison-heading">
              <h2 id="comparison-heading">Compared with other LiDAR robot mowers</h2>
              <p>
                The M5 LiDAR is listed here next to other published LiDAR listings, not every LiDAR model in this
                directory:{" "}
                {comparison.peers.map((peer, index) => {
                  const last = index === comparison.peers.length - 1;
                  const separator = index === 0 ? "" : last ? ", and " : ", ";
                  return (
                    <>
                      {separator}
                      <a href={peer.href}>{peer.title}</a>
                    </>
                  );
                })}
                . Every cell is copied from that listing’s price, coverage, slope, navigation, boundary, cutting width,
                cutting height, drive, noise, weight, and ingress rating. Prices are the amounts on those listings, with
                the date each one was checked. “Not listed” means that listing does not state the value. There is no
                ranking.
              </p>
              <div class="table-scroll">
                <table>
                  <caption>Listing specs for the M5 LiDAR and other published LiDAR mowers</caption>
                  <thead>
                    <tr>
                      <th scope="col">Spec</th>
                      {comparison.columns.map((column) => (
                        <th scope="col">
                          {column.href ? <a href={column.href}>{column.title}</a> : column.title}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {comparison.rows.map((row) => (
                      <tr>
                        <th scope="row">{row.label}</th>
                        {row.cells.map((cell) => (
                          <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )
        }
        {
          faqs.length > 0 && (
            <section id="faq" aria-labelledby="faq-heading">
              <h2 id="faq-heading">FAQ</h2>
              {faqs.map((faq) => (
                <section>
                  <h3>{faq.question}</h3>
                  <p>{faq.answer}</p>
                </section>
              ))}
            </section>
          )
        }
      </article>
      <aside class="side">
        <SpecTable listing={listing} />
        <div class="cta">
          {
            isPresentUrl(d.affiliateUrl) && (
              <a class="btn btn-primary" href={d.affiliateUrl} rel="sponsored nofollow noopener">
                Check price
              </a>
            )
          }
          {
            isPresentUrl(d.officialUrl) && (
              <a class="btn btn-ghost" href={d.officialUrl} rel="noopener noreferrer">
                Official product page
              </a>
            )
          }
          <p class="note">Updated {formatUpdated(d.updated)}. Specs that were not on the official page are omitted.</p>
          <p class="note"><a href={withBase()}>← All mowers</a></p>
        </div>
      </aside>
    </div>

    <RelatedListings items={related} />
  </div>
</BaseLayout>
