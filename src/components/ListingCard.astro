---
import type { CollectionEntry } from "astro:content";
import ProductPhoto from "./ProductPhoto.astro";
import {
  formatAcres,
  formatNav,
  formatPrice,
  listingPath,
  listingPhotoSrc,
  padIndex,
} from "../lib/site";

interface Props {
  listing: CollectionEntry<"listings">;
  index?: number;
  eager?: boolean;
  headingLevel?: "h2" | "h3";
  compare?: boolean;
}

const { listing, index, eager = false, headingLevel = "h2", compare = true } = Astro.props;
const Heading = headingLevel;
const {
  slug,
  brand,
  title,
  verdict,
  coverageAcres,
  slopePercent,
  navigation,
  wireFree,
  priceUsd,
  image,
} = listing.data;
const reference = index === undefined ? undefined : padIndex(index + 1);
---

<article
  class="product-card"
  data-listing-card
  data-slug={slug}
  data-wire={wireFree ? "free" : "wire"}
  data-coverage={coverageAcres}
  data-nav={navigation.join(" ")}
  data-title={title}
  data-brand={brand}
  data-price={priceUsd ?? ""}
  data-slope={slopePercent ?? ""}
  data-who={listing.data.whoItsFor}
  data-reveal
  style={index !== undefined ? `--reveal-delay:${(index % 2) * 110}ms` : undefined}
>
  <ProductPhoto src={listingPhotoSrc(slug, image)} alt={title} href={listingPath(slug)} eager={eager} />
  <div class="product-card-meta">
    {reference && <span class="product-card-idx">{reference}</span>}
    <div class="product-card-copy">
      <Heading>
        <a href={listingPath(slug)}>{title}</a>
      </Heading>
      <p class="product-card-kicker">
        {brand} · {formatNav(navigation)} · {formatAcres(coverageAcres)}
      </p>
    </div>
    <span class="product-card-price">{formatPrice(priceUsd)}</span>
  </div>
  <p class="product-card-verdict">{verdict}</p>
  <div class="product-card-foot">
    {
      compare && (
        <label class="compare-toggle">
          <input type="checkbox" data-compare value={slug} />
          Compare
        </label>
      )
    }
    <a class="link link-mono" href={listingPath(slug)}>Full listing</a>
  </div>
</article>
