---
import type { CollectionEntry } from "astro:content";
import {
  formatAcres,
  formatNav,
  formatPrice,
  listingPath,
} from "../lib/site";

interface Props {
  listing: CollectionEntry<"listings">;
}

const { listing } = Astro.props;
const { slug, brand, title, verdict, coverageAcres, slopePercent, navigation, wireFree, priceUsd } =
  listing.data;
---

<article
  class="card"
  data-listing-card
  data-slug={slug}
  data-wire={wireFree ? "free" : "wire"}
  data-coverage={coverageAcres}
  data-nav={navigation.join(" ")}
  data-title={title}
  data-brand={brand}
  data-price={priceUsd ?? ""}
  data-slope={slopePercent ?? ""}
  data-who={listing.data.whoItsFor}
>
  <div class="card-top">
    <span class="brand">{brand}</span>
    <span class="price">{formatPrice(priceUsd)}</span>
  </div>
  <h2><a href={listingPath(slug)}>{title}</a></h2>
  <p class="verdict">{verdict}</p>
  <dl class="specs">
    <div>
      <dt>Coverage</dt>
      <dd>{formatAcres(coverageAcres)}</dd>
    </div>
    <div>
      <dt>Slope</dt>
      <dd>{slopePercent !== undefined ? `${slopePercent}%` : "Not stated"}</dd>
    </div>
    <div>
      <dt>Navigation</dt>
      <dd>{formatNav(navigation)}</dd>
    </div>
    <div>
      <dt>Boundary</dt>
      <dd>
        <span class:list={["badge", { wire: !wireFree }]}>{wireFree ? "Wire-free" : "Boundary wire"}</span>
      </dd>
    </div>
  </dl>
  <div class="card-foot">
    <label class="compare-toggle">
      <input type="checkbox" data-compare value={slug} />
      Compare
    </label>
    <a href={listingPath(slug)}>Full listing</a>
  </div>
</article>
