---
import type { CollectionEntry } from "astro:content";
import ProductPhoto from "./ProductPhoto.astro";
import {
  formatAcres,
  formatNav,
  formatPrice,
  listingPath,
  listingPhotoSrc,
} from "../lib/site";

interface Props {
  listing: CollectionEntry<"listings">;
}

const { listing } = Astro.props;
const {
  slug,
  brand,
  title,
  verdict,
  coverageAcres,
  slopePercent,
  navigation,
  wireFree,
  priceUsd,
  cuttingWidthIn,
  driveType,
  ipRating,
  image,
} = listing.data;

const specRows: { label: string; value: string }[] = [
  { label: "Coverage", value: formatAcres(coverageAcres) },
  { label: "Slope", value: slopePercent !== undefined ? `${slopePercent}%` : "Not stated" },
  { label: "Nav", value: formatNav(navigation) },
  {
    label: "Boundary",
    value: wireFree ? "Wire-free" : "Boundary wire",
  },
];
if (cuttingWidthIn) specRows.push({ label: "Cut", value: `${cuttingWidthIn} in` });
if (driveType) specRows.push({ label: "Drive", value: driveType });
else if (ipRating) specRows.push({ label: "Ingress", value: ipRating });
---

<article
  class="card"
  data-listing-card
  data-slug={slug}
  data-wire={wireFree ? "free" : "wire"}
  data-coverage={coverageAcres}
  data-nav={navigation.join(" ")}
  data-title={title}
  data-brand={brand}
  data-price={priceUsd ?? ""}
  data-slope={slopePercent ?? ""}
  data-who={listing.data.whoItsFor}
>
  <ProductPhoto src={listingPhotoSrc(slug, image)} alt={title} href={listingPath(slug)}>
    <span class="price-stamp">{formatPrice(priceUsd)}</span>
  </ProductPhoto>
  <div class="bin-body">
    <p class="brand">{brand}</p>
    <h2><a href={listingPath(slug)}>{title}</a></h2>
    <dl class="specs">
      {
        specRows.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="verdict">{verdict}</p>
    <div class="card-foot">
      <label class="compare-toggle">
        <input type="checkbox" data-compare value={slug} />
        Compare
      </label>
      <a href={listingPath(slug)}>Full listing</a>
    </div>
  </div>
</article>
