---
import type { CollectionEntry } from "astro:content";
import { formatAcres, formatNav, formatPrice, formatUpdated } from "../lib/site";

interface Props {
  listing: CollectionEntry<"listings">;
}

const { listing } = Astro.props;
const d = listing.data;

const rows: { label: string; value: string }[] = [
  { label: "Brand", value: d.brand },
  { label: "Model", value: d.model },
  { label: "Recommended coverage", value: formatAcres(d.coverageAcres) },
  {
    label: "Max slope",
    value: d.slopePercent !== undefined ? `${d.slopePercent}%` : "Not stated on official page",
  },
  { label: "Navigation", value: formatNav(d.navigation) },
  { label: "Boundary", value: d.wireFree ? "Wire-free" : "Boundary wire" },
  { label: "Price (USD)", value: `${formatPrice(d.priceUsd)}${d.priceNote ? ` — ${d.priceNote}` : ""}` },
];

if (d.driveType) rows.push({ label: "Drive", value: d.driveType });
if (d.cuttingWidthIn) rows.push({ label: "Cutting width", value: `${d.cuttingWidthIn} in` });
if (d.cuttingHeight) rows.push({ label: "Cutting height", value: d.cuttingHeight });
if (d.noiseDb) rows.push({ label: "Noise", value: `${d.noiseDb} dB` });
if (d.weightLbs) rows.push({ label: "Weight", value: `${d.weightLbs} lb` });
if (d.ipRating) rows.push({ label: "Ingress rating", value: d.ipRating });
rows.push({ label: "Specs checked", value: formatUpdated(d.updated) });
---

<table class="spec-table">
  <caption class="visually-hidden">Key specifications</caption>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>{row.value}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  caption {
    text-align: left;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
</style>
