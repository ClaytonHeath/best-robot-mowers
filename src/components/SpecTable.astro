---
import type { CollectionEntry } from "astro:content";
import { formatAcres, formatNav, formatPrice, formatUpdated } from "../lib/site";

interface Props {
  listing: CollectionEntry<"listings">;
}

const { listing } = Astro.props;
const d = listing.data;

const rows: { label: string; value: string }[] = [
  { label: "Brand", value: d.brand },
  { label: "Model", value: d.model },
  { label: "Coverage", value: formatAcres(d.coverageAcres) },
  {
    label: "Max slope",
    value: d.slopePercent !== undefined ? `${d.slopePercent}%` : "Not stated",
  },
  { label: "Navigation", value: formatNav(d.navigation) },
  { label: "Boundary", value: d.wireFree ? "Wire-free" : "Boundary wire" },
  { label: "Price", value: formatPrice(d.priceUsd) },
];

if (d.priceNote) rows.push({ label: "Price note", value: d.priceNote });
if (d.driveType) rows.push({ label: "Drive", value: d.driveType });
if (d.cuttingWidthIn) rows.push({ label: "Cut width", value: `${d.cuttingWidthIn} in` });
if (d.cuttingHeight) rows.push({ label: "Cut height", value: d.cuttingHeight });
if (d.noiseDb) rows.push({ label: "Noise", value: `${d.noiseDb} dB` });
if (d.weightLbs) rows.push({ label: "Weight", value: `${d.weightLbs} lb` });
if (d.ipRating) rows.push({ label: "Ingress", value: d.ipRating });
rows.push({ label: "Specs checked", value: formatUpdated(d.updated) });
---

<div>
  <p class="label">Specification</p>
  <dl class="plate">
    {
      rows.map((row) => (
        <div class="plate-row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
