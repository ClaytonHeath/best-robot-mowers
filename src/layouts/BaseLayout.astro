---
import "../styles/global.css";
import { OWNER, SITE_NAME, SITE_URL, assetPath, stringifyJsonLd, withBase } from "../lib/site";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: "website" | "article";
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonicalPath = "", type = "website", ogImage, jsonLd } = Astro.props;
const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(withBase(canonicalPath), site);
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
const path = Astro.url.pathname;
const ogImageAbs = ogImage ? new URL(ogImage, site).href : undefined;
const jsonLdBlocks = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={OWNER} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    {
      jsonLdBlocks.map((block) => (
        <script is:inline type="application/ld+json" set:html={stringifyJsonLd(block)} />
      ))
    }
    <meta name="twitter:card" content={ogImageAbs ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}
    <link rel="icon" href={assetPath("favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href={withBase()}>
          <span class="wordmark-title">{SITE_NAME}</span>
          <small>{OWNER}</small>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href={withBase()} aria-current={path === withBase() ? "page" : undefined}>Floor</a>
          <a href={withBase("about")} aria-current={path.includes("/about") ? "page" : undefined}>Method</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <p class="footer-brand">{SITE_NAME}</p>
          <p>
            {OWNER}. We don’t take payment for rankings.
            Some links may be affiliate.
          </p>
        </div>
        <div>
          <p class="footer-label">On the floor</p>
          <p><a href={withBase()}>All mowers</a></p>
          <p><a href={withBase("about")}>How a listing is written</a></p>
        </div>
        <div>
          <p class="footer-label">Host</p>
          <p>Live at bestlawnrobots.com. Specs come from official product pages, not press quotes.</p>
        </div>
      </div>
    </footer>
    <script data-goatcounter="https://bestlawnrobots.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
